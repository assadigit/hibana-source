# Hibana .gitignore — tidied S199 (HLTH-15): grouped + sorted, the stray curl
# output lines ('-- -s', '-s') dropped, hibana.db added (the 0-byte root placeholder
# was git-rm'd this round; real dev DB is data/hibana.db).

# dependencies / build / tooling
# (package-lock.json retired S199 — bun.lock is the one lockfile; the on-the-fly
# CI audit lock never ships)
package-lock.json
node_modules/
.wrangler/
.build-backup/
dist/
public/dist/
coverage/
test-results/
playwright-report/
tmp-debug/
scripts/tmp/
.tmp-s*/
.qa-tmp/

# local databases (real dev DB lives in data/; WAL/SHM sidecars never ship)
data/
hibana.db
hibana.db-shm
hibana.db-wal
*.sql.tmp

# secrets — gitignored forever; the agent reads credentials.md but it never ships
credentials.md
Credentials.md
.dev.vars
.dev.vars.*
.secrets.env
.admin.secrets
.env

# session cookies / curl jars (never commit auth material)
cookies.txt
*.cookies

# local logs + screenshots + debug artifacts
*.log
dashboard-check.png
audit-results/shots/
