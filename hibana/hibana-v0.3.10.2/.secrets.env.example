# One-time credential hand-off (NEVER commit this file — it is gitignored).
# Fill in the values, then run: npm run secrets:set
# Values are read from this file and piped straight into `wrangler secret put`
# (and .dev.vars) WITHOUT ever being printed. Delete this file once done.

# GitHub personal access token — fine-grained token scoped to the hibana-safe repo,
# permission "Contents: Read and write". Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# Resend API key — free tier, no card. Sign up at https://resend.com (email verification),
# then API Keys → create. Used for password-reset emails + client-work reminders.
RESEND_KEY=

# Telegram bot token + webhook secret:
#  1. Message @BotFather → /newbot → copy the HTTP API token
#  2. Pick a random secret string; the wizard uses the same value for the webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET=

# Where client-work reminder emails are sent (your email address)
OWNER_EMAIL=

# Backup encryption key (C3 fix, 2026-09-10): a base64-encoded 32-byte AES-GCM key.
# When set, every backup snapshot is encrypted BEFORE it touches the GitHub assets repo —
# a token leak no longer yields readable user data. Generate a key:
#   openssl rand -base64 32
# CRITICAL: store this key somewhere safe OUTSIDE the repo (password manager, offline
# backup). If you lose it, encrypted backups CANNOT be decrypted. Without this key set,
# backups fall back to plaintext (dev/test only — production MUST set this).
BACKUP_ENCRYPTION_KEY=

# Cloudflare Turnstile secret key (CAPTCHA on signup only — login is guarded by its own
# rate limiter, by decision 2026-08-25). NOT the site key — the site key is public and
# lives in public/signup.html.
# Create: dashboard.cloudflare.com → your account → Turnstile → Add site (appearance:
# interaction-only; domains: the workers.dev URLs + hibana.ir… then replace the site
# key placeholder in public/signup.html and redeploy.
TURNSTILE_SECRET_KEY=
