{
  "name": "hibana",
  "version": "0.3.13.1",
  "private": true,
  "type": "module",
  "description": "Personal project & idea manager \u2014 Cloudflare Workers (D1) or plain Node (SQLite)",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build.mjs --prod",
    "build:dev": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "deploy": "node scripts/build.mjs --prod --wire-html && node scripts/check-dist-wiring.mjs && wrangler deploy && node scripts/build.mjs --restore-html",
    "deploy:prod": "node scripts/build.mjs --prod --wire-html && node scripts/check-dist-wiring.mjs && wrangler deploy --env prod && node scripts/build.mjs --restore-html",
    "start:node": "node --import tsx src/server.ts",
    "migrate:node": "node --import tsx scripts/migrate-node.ts",
    "restore": "node scripts/restore.mjs",
    "restore:safe": "node scripts/restore-safe.mjs",
    "drill": "node --import tsx scripts/restore-drill.mjs",
    "drill:planb": "node scripts/restore-drill-planb.mjs",
    "bookmark:prod": "node scripts/pre-migrate-bookmark.mjs --reason 'pre-migration bookmark (prod)'",
    "bookmark:dev": "node scripts/pre-migrate-bookmark.mjs --dev --reason 'pre-migration bookmark (dev)'",
    "check-dist-wiring": "node scripts/check-dist-wiring.mjs",
    "perf:explain": "node --import tsx scripts/explain-hotpaths.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:admin:prod": "node scripts/seed-admin.mjs --prod",
    "seed:admin:node": "node scripts/seed-admin.mjs --node",
    "secrets:set": "node scripts/set-secrets.mjs",
    "secrets:set:prod": "node scripts/set-secrets.mjs --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "shotcheck:local": "node --import tsx scripts/live-shot-check.mjs --local",
    "shotcheck:dev": "node --import tsx scripts/live-shot-check.mjs --remote dev",
    "shotcheck:prod": "node --import tsx scripts/live-shot-check.mjs --remote prod",
    "probe:emoji": "node scripts/live-emoji-probe.mjs",
    "probe:carousel": "node scripts/live-carousel-probe.mjs",
    "probe:carousel:dev": "node scripts/live-carousel-probe.mjs --dev",
    "probe:emoji:dev": "node scripts/live-emoji-probe.mjs --dev",
    "typecheck": "tsc --noEmit",
    "check-cache-bust": "node scripts/check-cache-bust.mjs",
    "check-i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:prod-errors": "node scripts/check-prod-errors.mjs",
    "test:workers": "node scripts/workers-smoke.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "probe:tags": "node scripts/live-tags-probe.mjs dev",
    "probe:tags:prod": "node scripts/live-tags-probe.mjs prod",
    "probe:glance": "node scripts/live-glance-probe.mjs dev",
    "probe:glance:prod": "node scripts/live-glance-probe.mjs prod"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "playwright": "^1.62.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
